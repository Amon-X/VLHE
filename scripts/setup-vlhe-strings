# CD Settings
# ------------------------------------------------------------------

STR_CdLoadAtBoot="Enable CD"
STR_CdLoadAtBoot_HELP="Yes loads the virtual CD-ROM module and its daemon every time the
machine boots. No leaves it installed but not started. Whether the
last disc images come back at boot is in CD Settings."
STR_CdLoadAtBoot_1="Yes - load it at boot"
STR_CdLoadAtBoot_0="No - not loaded at boot"

STR_Drives="Virtual drives"
STR_Drives_HELP=""

STR_Major="Present drive as (block major)"
STR_Major_HELP=""
# The first list, offered plainly
STR_Major_63="Local/experimental - (the reference uses this)"
STR_Major_62="Local/experimental"
STR_Major_61="Local/experimental"
STR_Major_60="Local/experimental"
# The second list, behind the engine's gate - real drivers' majors
STR_Major_25="Matsushita / Panasonic CR-5xx, second unit"
STR_Major_26="Matsushita / Panasonic CR-5xx, third unit"
STR_Major_27="Matsushita / Panasonic CR-5xx, fourth unit"
STR_Major_28="Matsushita / Panasonic CR-5xx, fifth unit"
STR_Major_15="Sony CDU-31A / CDU-33A"
STR_Major_24="Sony CDU-535"

STR_DrivesAutoLoad="Reattach the last images at boot"
STR_DrivesAutoLoad_HELP=""
STR_DrivesAutoLoad_1="Reattach the images that were loaded"
STR_DrivesAutoLoad_0="Start with empty drives"

STR_Tracing="Debug tracing"
STR_Tracing_HELP="For a bug report. Traces the next load to the kernel log; turn it off again after."
STR_Tracing_0="Off"
STR_Tracing_1="Events - what a test needs"
STR_Tracing_2="Everything - very large logs"

STR_TraceCapture="Save the traces to a run folder"
STR_TraceCapture_HELP="Testing only: stops the system log for the run. Needs tracing on."
STR_TraceCapture_1="Run folder beside DAEMON.LOG"
STR_TraceCapture_0="System log - /var/log/kern"
STR_FinishLeftover="Finish leftover changes at boot"
STR_FinishLeftover_HELP="After a power loss or a crash while VLHE was loaded, the changes it
made are still on record. Yes: the boot puts back only what VLHE made,
then loads. No: the boot only notes it and VLHE stays unloaded."
STR_FinishLeftover_1="Yes - put them back, then load"
STR_FinishLeftover_0="No - only note it, stay unloaded"
STR_BaselineDrift="When a device file has changed"
STR_BaselineDrift_HELP="When something other than VLHE changed /dev/dsp, /dev/cdrom or
another file it manages, what a Load does. The boot always warns."
STR_BaselineDrift_ask="Ask - undo, accept, load anyway, or cancel"
STR_BaselineDrift_warn="Warn - keep the baseline, load, and say so"
STR_BaselineDrift_refuse="Refuse - stop the load, change nothing"
STR_ChannelRelease="Channel release, milliseconds"
STR_ChannelRelease_HELP="Silence before the synth lets its sound channel go, so the card can
be released between songs. Outlast any rest inside a piece: the first
note after a release is ~100 ms late. 0 holds the channel always."
STR_AutoVoiceDrain="Start lowering below, per cent"
STR_AutoVoiceDrain_HELP="Start reducing while the buffer averages below this and is not rising."
STR_AutoVoiceEmergency="Shed fading notes at once below, per cent"
STR_AutoVoiceEmergency_HELP="Below this, every release tail ends at once and the limit drops to
what is left."
STR_AutoVoiceHealthy="Restore the full limit at, per cent"
STR_AutoVoiceHealthy_HELP="At or above this, and not falling, the full voice limit comes back."
STR_AutoVoiceSettle="Wait between steps, milliseconds"
STR_AutoVoiceSettle_HELP="Time after acting before acting again, so the change can show."
STR_AutoVoiceFloor="Never fewer voices than"
STR_AutoVoiceFloor_HELP=""
STR_AutoVoiceTails="End fading notes early first"
STR_AutoVoiceTails_HELP="Ends notes already fading - quietest first, never drums, over about
10 ms so nothing clicks - before lowering the limit. Held notes are
never cut."
STR_AutoVoiceTails_1="Yes - quietest fading notes first"
STR_AutoVoiceTails_0="No - only lower the limit"
